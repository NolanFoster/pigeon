{
  "id": "/",
  "name": "Pigeon",
  "short_name": "Pigeon",
  "description": "Push notifications, simple as HTTP",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "categories": ["productivity", "utilities"],
  "background_color": "#faf8f5",
  "theme_color": "#654f44",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Subscribe to a topic",
      "short_name": "Subscribe",
      "description": "Subscribe to a Pigeon topic",
      "url": "/?action=subscribe",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Send a message",
      "short_name": "Compose",
      "description": "Compose a message for the selected Pigeon topic",
      "url": "/?action=compose",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    { "src": "/screenshot-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Pigeon desktop view" },
    { "src": "/screenshot-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Pigeon mobile view" }
  ]
}
